{
  "name": "quilldb",
  "version": "1.1.1",
  "description": "QuillDB - Cross-platform desktop database management tool",
  "desktopName": "QuillDB",
  "main": "./out/main/index.js",
  "author": "CodeAce",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "yarn typecheck && electron-vite build",
    "build:harmony:web": "vite build --config vite.harmony.config.ts",
    "build:harmony": "yarn build:harmony:web",
    "dist": "yarn build && electron-builder",
    "dist:mac": "yarn build && electron-builder --mac",
    "dist:win": "yarn build && electron-builder --win",
    "dist:linux": "yarn build && electron-builder --linux"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@tanstack/react-virtual": "^3.14.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "duckdb": "^1.4.4",
    "ioredis": "^5.11.1",
    "mongodb": "^7.5.0",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.0",
    "pg": "^8.22.0",
    "pg-cursor": "^2.21.0",
    "ssh2": "^1.17.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql-formatter": "^15.8.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.quilldb.desktop",
    "productName": "QuillDB",
    "copyright": "Copyright © 2026 CodeAce",
    "executableName": "QuillDB",
    "artifactName": "QuillDB-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,LICENSE,LICENSE.txt,license.txt}",
      "!**/node_modules/*/{test,__tests__,tests,example,examples,docs,.github}",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/.bin",
      "!**/node_modules/**/*.c",
      "!**/node_modules/**/*.h",
      "!**/node_modules/**/*.cc",
      "!**/node_modules/**/*.cpp",
      "!**/node_modules/**/*.o",
      "!**/node_modules/**/binding.gyp",
      "!**/node_modules/**/Makefile",
      "!**/node_modules/**/CMakeLists.txt",
      "!src/**/*",
      "!electron.vite.config.ts",
      "!tsconfig*.json",
      "!vite.harmony.config.ts",
      "!release/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "electronLanguages": [
        "zh_CN",
        "en"
      ],
      "extendInfo": {
        "CFBundleName": "QuillDB",
        "CFBundleDisplayName": "QuillDB"
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Development",
      "maintainer": "CodeAce",
      "syncDesktopName": true,
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "artifactName": "QuillDB-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuillDB"
    },
    "portable": {
      "artifactName": "QuillDB-Portable-${version}-${arch}.${ext}"
    }
  },
  "packageManager": "yarn@1.22.22"
}
